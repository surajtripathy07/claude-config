#!/usr/bin/env bash
# worktree-bootstrap [--check] [<worktree-path>]
# Makes a fresh git worktree usable (gitignored config, gems, node_modules, hooks), then proves it.
# Extra node_modules/.bin binaries to check, one per line (# comments), from the first that exists:
#   <primary-checkout>/.worktree-bootstrap.local
#   ~/.claude/local/worktree-bootstrap/<primary-checkout-basename>.txt
set -uo pipefail

CHECK_ONLY=0
TARGET=""
for arg in "$@"; do
  case "$arg" in
    --check) CHECK_ONLY=1 ;;
    -h|--help) sed -n 2,6p "$0" | sed 's/^# //'; exit 0 ;;
    *) TARGET="$arg" ;;
  esac
done
TARGET="$(cd "${TARGET:-$PWD}" && pwd -P)" || exit 2

COMMON="$(git -C "$TARGET" rev-parse --path-format=absolute --git-common-dir)" || exit 2
PRIMARY="$(cd "$COMMON/.." && pwd -P)"
if [ "$TARGET" = "$PRIMARY" ]; then
  echo "$TARGET is the primary checkout; nothing to bootstrap."
  exit 0
fi
cd "$TARGET" || exit 2

# Bare `bundle`/`git` resolve to the system Ruby 2.6 and break lefthook; everything goes through mise.
mx() { mise exec -- "$@"; }

step() { echo "== $*"; }

ignored_config() {
  local f
  for f in .env .env.local config/database.yml "$PRIMARY"/config/*.yml; do
    f="${f#"$PRIMARY"/}"
    [ -e "$PRIMARY/$f" ] || continue
    # Only ignored files are worktree-local state; tracked ones already arrived with the checkout.
    git -C "$PRIMARY" check-ignore -q "$f" && echo "$f"
  done | sort -u
}

copy_ignored_config() {
  step "gitignored config from $PRIMARY"
  local f
  for f in $(ignored_config); do
    if [ -e "$TARGET/$f" ]; then
      echo "present: $f"
    else
      mkdir -p "$TARGET/$(dirname "$f")"
      cp -p "$PRIMARY/$f" "$TARGET/$f" && echo "copied:  $f"
    fi
  done
}

expected_ruby() {
  if [ -f .ruby-version ]; then tr -d '[:space:]' < .ruby-version | sed 's/^ruby-//'
  elif [ -f .tool-versions ]; then awk '$1=="ruby"{print $2}' .tool-versions
  fi
}

install_ruby_deps() {
  step "ruby / gems"
  mx bundle check >/dev/null 2>&1 || mx bundle install
}

node_stale() {
  [ ! -d node_modules ] || [ yarn.lock -nt node_modules ]
}

install_node_deps() {
  step "node"
  if [ -f yarn.lock ]; then
    if node_stale; then
      local start=$SECONDS
      mx yarn install --frozen-lockfile
      echo "yarn install took $((SECONDS - start))s"
      touch node_modules
    else
      echo "node_modules up to date (yarn.lock)"
    fi
  elif [ -f package-lock.json ]; then
    echo "package-lock.json found but this repo is expected to use yarn; skipping" >&2
  fi
}

FAILS=0
row() { # name status detail
  printf 'CHECK %-22s %s %s\n' "$1" "$2" "$3"
  [ "$2" = PASS ] || FAILS=$((FAILS + 1))
}

extra_bins() {
  local f
  for f in "$PRIMARY/.worktree-bootstrap.local" "$HOME/.claude/local/worktree-bootstrap/$(basename "$PRIMARY").txt"; do
    [ -f "$f" ] || continue
    sed -e 's/#.*//' -e 's/[[:space:]]//g' "$f" | grep -v '^$'
    return
  done
}

run_checks() {
  step "checks"
  local want got bin f
  want="$(expected_ruby)"
  if [ -n "$want" ]; then
    got="$(mx ruby -v 2>/dev/null | awk '{print $2}' | sed 's/p[0-9]*$//')"
    if [ "$got" = "$want" ]; then row ruby-version PASS "$got"
    else row ruby-version FAIL "want=$want got=${got:-none}"; fi
  fi

  if [ -f Gemfile ]; then
    if mx bundle check >/dev/null 2>&1; then row bundle-check PASS ""
    else row bundle-check FAIL "gems missing"; fi
  fi

  if [ -f package.json ]; then
    if [ -d node_modules ]; then row node_modules PASS ""
    else row node_modules FAIL "node_modules missing"; fi
  fi

  for bin in $(extra_bins); do
    if [ -x "node_modules/.bin/$bin" ]; then row "$bin" PASS "node_modules/.bin/$bin"
    else row "$bin" FAIL "node_modules/.bin/$bin missing"; fi
  done

  for f in $(ignored_config); do
    if [ -e "$f" ]; then row "$f" PASS "copied"
    else row "$f" FAIL "missing; present in $PRIMARY"; fi
  done

  local hooks shared
  hooks="$(git rev-parse --path-format=absolute --git-path hooks)"
  shared="$COMMON/hooks"
  if mx lefthook version >/dev/null 2>&1 && [ "$hooks" = "$shared" ]; then
    row lefthook PASS "$(mx lefthook version) hooks=$hooks"
  else
    row lefthook FAIL "resolves=$(mx lefthook version >/dev/null 2>&1 && echo yes || echo no) hooks=$hooks shared=$shared"
  fi
}

if [ "$CHECK_ONLY" -eq 0 ]; then
  copy_ignored_config
  want="$(expected_ruby)"
  got="$(mx ruby -v 2>/dev/null | awk '{print $2}' | sed 's/p[0-9]*$//')"
  [ "$got" = "$want" ] || echo "WARN: mise ruby is '${got:-none}', expected '$want'; run 'mise install' in $TARGET" >&2
  install_ruby_deps
  install_node_deps
fi

run_checks
echo "Reminder: commit and push with \`mise exec -- git ...\`"
[ "$FAILS" -eq 0 ]
