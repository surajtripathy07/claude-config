#!/usr/bin/env python3
"""Sum Claude Code token usage per session, per model, main-vs-subagent, from the local
transcripts in ~/.claude/projects/*/ and join with ~/.claude/experiments/sessions.tsv
(written by hooks/orchestrate-sessionstart.sh) so sessions can be grouped by arm.

  session-cost                      # all sessions, last 7 days, current project
  session-cost --since 2026-09-01   # date filter
  session-cost --all-projects
  session-cost --by arm             # aggregate: arm | model | label | session (default session)
  session-cost --session <id>       # one session, per-agent breakdown
  session-cost --csv                # machine-readable

Dollars are ESTIMATES from experiments/prices.json (see its _note). Tokens are exact.
Per-turn columns (turns, in/turn, cread/turn, cwrite/turn, usd/turn, cache%) normalize
for session length: turns = human-typed user messages in the main transcript (excludes
tool_results, harness injections like <command-name>/<system-reminder>, and isMeta rows).
"""
import argparse, csv, glob, json, os, sys, datetime as dt
from collections import defaultdict

HOME = os.path.expanduser("~")
PROJECTS = os.path.join(HOME, ".claude", "projects")
SESSIONS_TSV = os.path.join(HOME, ".claude", "experiments", "sessions.tsv")
PRICES = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "experiments", "prices.json")
FIELDS = ["input_tokens", "cache_read_input_tokens", "cache_creation_input_tokens", "output_tokens"]

def load_prices():
    try:
        with open(PRICES) as f:
            return {k: v for k, v in json.load(f).items() if not k.startswith("_")}
    except OSError:
        return {}

def price_for(model, prices):
    for k in sorted(prices, key=len, reverse=True):
        if model.startswith(k):
            return prices[k]
    return None

def usd(u, p):
    if not p: return None
    cc = u.get("cache_creation", {}) or {}
    w1h = cc.get("ephemeral_1h_input_tokens", 0) or 0
    w5m = (u.get("cache_creation_input_tokens", 0) or 0) - w1h
    return (u.get("input_tokens", 0) * p["input"] + u.get("cache_read_input_tokens", 0) * p["cache_read"]
            + w5m * p["cache_write_5m"] + w1h * p["cache_write_1h"] + u.get("output_tokens", 0) * p["output"]) / 1e6

def project_dir_for_cwd(cwd):
    return os.path.join(PROJECTS, cwd.replace("/", "-"))

def iter_messages(path):
    """Yield (message_id, model, usage, timestamp, is_subagent) deduped by message id."""
    seen = {}
    with open(path, errors="replace") as f:
        for line in f:
            try: d = json.loads(line)
            except ValueError: continue
            if d.get("type") != "assistant": continue
            m = d.get("message") or {}
            if str(m.get("model", "")).startswith("<"): continue  # <synthetic> placeholder rows
            u = m.get("usage")
            if not u: continue
            mid = m.get("id") or d.get("uuid")
            seen[mid] = (m.get("model", "?"), u, d.get("timestamp"), bool(d.get("isSidechain")) or bool(d.get("agentId")))
    return seen.values()

INJECTION_TAGS = ("<system-reminder>", "<command-name>", "<local-command-stdout>", "<local-command-caveat>", "<task-notification>")

def is_human_text_block(content):
    """A list `content` counts as a human turn if it has >=1 text block and no tool_result."""
    has_text = False
    for block in content:
        if not isinstance(block, dict): continue
        t = block.get("type")
        if t == "tool_result": return False
        if t == "text" and not str(block.get("text", "")).startswith(INJECTION_TAGS):
            has_text = True
    return has_text

def count_user_turns(path):
    """Count human-typed user turns in a main transcript (not subagent files)."""
    n = 0
    with open(path, errors="replace") as f:
        for line in f:
            try: d = json.loads(line)
            except ValueError: continue
            if d.get("type") != "user": continue
            if d.get("isMeta"): continue
            m = d.get("message") or {}
            c = m.get("content")
            if isinstance(c, str):
                if not c.startswith(INJECTION_TAGS): n += 1
            elif isinstance(c, list):
                if is_human_text_block(c): n += 1
    return n

def per_turn_cols(r, turns):
    """[turns, in/turn, cread/turn, cwrite/turn, usd/turn, cache%] for a group total row r."""
    if not turns:
        return [0, "-", "-", "-", "-", "-"]
    inp, cread, cwrite = r["input_tokens"], r["cache_read_input_tokens"], r["cache_creation_input_tokens"]
    denom = inp + cread + cwrite
    cache_pct = ("%.1f%%" % (100.0 * cread / denom)) if denom else "-"
    usd_per_turn = ("%.4f" % (r["usd"] / turns)) if r.get("priced", True) else "n/a"
    return [turns, "%.0f" % (inp / turns), "%.0f" % (cread / turns), "%.0f" % (cwrite / turns), usd_per_turn, cache_pct]

def load_labels():
    labels = {}
    if os.path.exists(SESSIONS_TSV):
        with open(SESSIONS_TSV) as f:
            for row in csv.DictReader(f, delimiter="\t"):
                labels[row["session_id"]] = row
    return labels

def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--since", help="YYYY-MM-DD (default: 7 days ago)")
    ap.add_argument("--all-projects", action="store_true")
    ap.add_argument("--session", help="one session id (prefix ok)")
    ap.add_argument("--by", choices=["session", "arm", "model", "label"], default="session")
    ap.add_argument("--csv", action="store_true")
    a = ap.parse_args()

    since = dt.datetime.fromisoformat(a.since) if a.since else dt.datetime.now() - dt.timedelta(days=7)
    prices, labels = load_prices(), load_labels()
    roots = [PROJECTS] if a.all_projects else [project_dir_for_cwd(os.getcwd())]

    # rows: (session, arm, label, model, tier, tokens..., usd)
    agg = defaultdict(lambda: {k: 0 for k in FIELDS} | {"usd": 0.0, "msgs": 0, "priced": True})
    key_sids = defaultdict(set)   # key -> set of session ids contributing to it (to sum turns once/session)
    turns_by_sid = {}
    for root in roots:
        for main in glob.glob(os.path.join(root, "*.jsonl")):
            sid = os.path.basename(main)[:-6]
            if a.session and not sid.startswith(a.session): continue
            if dt.datetime.fromtimestamp(os.path.getmtime(main)) < since: continue
            lab = labels.get(sid, {})
            arm = lab.get("headroom", "unknown"); label = lab.get("label", "") or "-"
            turns_by_sid[sid] = count_user_turns(main)
            files = [(main, "main")] + [(p, "sub:" + os.path.basename(p)[6:-6]) for p in glob.glob(os.path.join(root, sid, "subagents", "agent-*.jsonl"))]
            for path, tier in files:
                for model, u, ts, is_sub in iter_messages(path):
                    key = {"session": (sid[:8], arm, label, model, tier if a.session else ("sub" if tier != "main" else "main")),
                           "arm": (arm, model), "model": (model,), "label": (label, arm, model)}[a.by]
                    r = agg[key]
                    for k in FIELDS: r[k] += u.get(k, 0) or 0
                    c = usd(u, price_for(model, prices))
                    if c is None: r["priced"] = False
                    else: r["usd"] += c
                    r["msgs"] += 1
                    key_sids[key].add(sid)

    heads = {"session": ["session", "arm", "label", "model", "agent"], "arm": ["arm", "model"], "model": ["model"], "label": ["label", "arm", "model"]}[a.by]
    cols = heads + ["msgs", "input", "cache_read", "cache_write", "output", "est_usd", "turns", "in/turn", "cread/turn", "cwrite/turn", "usd/turn", "cache%"]
    rows = []
    for key in sorted(agg):
        r = agg[key]
        t = sum(turns_by_sid.get(sid, 0) for sid in key_sids[key])
        rows.append(list(key) + [r["msgs"], r["input_tokens"], r["cache_read_input_tokens"], r["cache_creation_input_tokens"], r["output_tokens"], ("%.2f" % r["usd"]) if r["priced"] else "n/a"] + per_turn_cols(r, t))
    tot = defaultdict(float)
    all_sids = set()
    for key, r in agg.items():
        for k in FIELDS: tot[k] += r[k]
        tot["usd"] += r["usd"]; tot["msgs"] += r["msgs"]
        all_sids |= key_sids[key]
    tot_turns = sum(turns_by_sid.get(sid, 0) for sid in all_sids)
    rows.append(["TOTAL"] + [""] * (len(heads) - 1) + [int(tot["msgs"]), int(tot["input_tokens"]), int(tot["cache_read_input_tokens"]), int(tot["cache_creation_input_tokens"]), int(tot["output_tokens"]), "%.2f" % tot["usd"]] + per_turn_cols(tot, tot_turns))

    if a.csv:
        w = csv.writer(sys.stdout); w.writerow(cols); w.writerows(rows); return
    widths = [max(len(str(x)) for x in col) for col in zip(cols, *rows)]
    fmt = "  ".join("{:>%d}" % w if i >= len(heads) else "{:<%d}" % w for i, w in enumerate(widths))
    print(fmt.format(*cols)); print(fmt.format(*["-" * w for w in widths]))
    for r in rows: print(fmt.format(*[str(x) for x in r]))
    print("\nest_usd uses %s (unverified list prices; tokens are exact). arm = headroom on/off from sessions.tsv; 'unknown' = session predates the SessionStart hook." % os.path.relpath(PRICES, HOME))
    print("turns = human-typed user messages (main transcript only); */turn columns are group_total / group_turns, turns summed once per session.")

if __name__ == "__main__":
    main()
